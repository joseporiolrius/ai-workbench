# Backend configuration EXAMPLE (schema) for the controller-owned local backend.
#
# The state file is controller-owned and lives OUTSIDE this repository (doc-18
# §2, §3). Do NOT commit real state, and do NOT create a second state manager or
# download the professor's state. You supply the concrete path at init time:
#
#   terraform init -backend-config=path=<controller-state>/workspace.tfstate
#
# or copy this file to backend.hcl (git-ignored) and:
#
#   terraform init -backend-config=backend.hcl
#
# The path below is the per-environment workspace state the dbai console already
# created for you; point at THAT file so adoption plans against existing state.
path = "/home/<you>/.local/state/ec2-console/dbai/<student_id>/workspace.tfstate"
